{
  "name": "@kya/sdk",
  "version": "0.1.0",
  "description": "KYA Gateway client: agent keys, signed purchase intents, delegation and merchant verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0"
  }
}
