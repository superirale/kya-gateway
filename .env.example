# ---- KYA Gateway configuration (copy to .env). Never commit .env. ----

# local: simulated intelligence allowed, ephemeral secrets generated if unset.
# competition: real Telegraph x402 only; Postgres + explicit secrets required; simulated evidence never ALLOWs.
KYA_MODE=local

# Merchant API keys: merchant_id:key[,merchant_id:key]. Keys >= 16 chars. Must match MERCHANT_API_KEY below.
KYA_MERCHANT_KEYS=merchant_demo_001:local-demo-merchant-key-0001
MERCHANT_API_KEY=local-demo-merchant-key-0001
# Admin key for agent disable/enable.
KYA_ADMIN_KEY=change-me-admin-key-0001

# Delegation issuer Ed25519 seed (32 bytes base64url).
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
KYA_ISSUER_SEED=
KYA_ISSUER_KID=demo-issuer-1
# HMAC secret for demo consumer sessions (>= 32 chars):  openssl rand -hex 32
KYA_SESSION_SECRET=
# Synthetic demo consumer accounts (user:password). NOT identity proofing.
KYA_DEMO_CONSUMERS=alice:alice-demo-pass

KYA_CLOCK_SKEW_SECONDS=300
# Decision when intelligence is unavailable/unverified: REVIEW (default) or DENY (strict). Never ALLOW.
KYA_FAIL_CLOSED_DECISION=REVIEW
KYA_RATE_LIMIT_PER_MIN=120

# ---- Telegraph ----
# simulated (local only, clearly labeled) | x402 (real testnet purchase)
TELEGRAPH_ADAPTER=simulated
TELEGRAPH_BASE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_INTENT=FRAUD_RISK_GENERAL
TELEGRAPH_NETWORK=eip155:11155111
# Optional: pin a miner (POST /engine/v1/ask/{id}). 501 = Telegraph Sentinel, which returns structured
# risk_level/risk_score for free-text subjects. Leave empty for Telegraph auto-routing.
TELEGRAPH_MINER_ID=501
# Test USDC on Sepolia (6 decimals). KYA will only ever sign payments in these assets.
TELEGRAPH_ALLOWED_ASSETS=0xcc194e1a843B658526D0D5C431f670028582Ae17
# Sepolia wallet private key (hex). TESTNET ONLY; fund with capped test USDC. Prefer the _FILE form.
TELEGRAPH_WALLET_KEY=
# TELEGRAPH_WALLET_KEY_FILE=/run/secrets/telegraph_wallet_key
# Spend caps in micro-USDC: $0.05 per call, $2.00 per UTC day, at most 2 concurrent paid calls.
TELEGRAPH_MAX_PRICE_MINOR=50000
TELEGRAPH_DAILY_CAP_MINOR=2000000
TELEGRAPH_MAX_CONCURRENT=2
TELEGRAPH_TIMEOUT_SECONDS=25
TELEGRAPH_MAX_RETRIES=2
# Independent on-chain receipt verification (required for SETTLED evidence).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TELEGRAPH_EXPLORER_TX_TEMPLATE=https://sepolia.etherscan.io/tx/%s
